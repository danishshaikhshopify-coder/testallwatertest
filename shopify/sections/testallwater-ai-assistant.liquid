  // mode (`.tw-mode-inline .tw-close-btn{display:none}`), so it only needs a click handler here.
  if (FLOATING) {
    if (launcher) launcher.onclick = function () { root.classList.add("tw-open"); input.focus(); };
    if (closeBtn) closeBtn.onclick = function () { root.classList.remove("tw-open"); };
  }
