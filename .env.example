# Copy this file to .env for local development and add your NaraRouter API key.
# Never commit a real key.
NARA_ROUTER_API_KEY=your-nararouter-api-key
NARA_ROUTER_BASE_URL=https://router.bynara.id/v1

# Optional comma-separated free models. The app falls back to the second model when needed.
NARA_ROUTER_MODELS=nemotron-3-super-free,nemotron-3-ultra-free
