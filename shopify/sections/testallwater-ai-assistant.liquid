{% comment %}
  TestAllWater AI Assistant — Shopify Custom Section

  Self-contained chat widget: calls the deployed Vercel /api/chat endpoint (see "API endpoint
  URL" setting below), renders the AI's reply, quick-reply buttons, and real product cards
  built only from the fields that endpoint returns. No Shopify app, no secrets of any kind —
  ANTHROPIC_API_KEY and any Shopify credential stay server-side in the Vercel deployment;
  nothing here ever references them.

  Ported from the project's index.html prototype, adapted for use inside an existing theme
  page: global `:root`/`body`/`*` styling has been scoped to this section's own wrapper so it
  cannot affect the rest of the theme, and every element id is suffixed with {{ section.id }}
  so the section can be added more than once on the same page without colliding.

  Visual design: premium product-finder look (flat brand color, soft borders, minimal shadow,
  editorial assistant messages, CSS-only water-drop mark). All element ids and the class names
  the script below creates/queries (tw-row, tw-bubble, tw-reply/.other, tw-pcard, tw-ptitle,
  etc.) are unchanged from the previous version, so behavior and tests are unaffected — only
  markup/CSS that is purely presentational was restyled or restructured.
{% endcomment %}
{%- liquid
  assign tw_id = section.id
  assign tw_endpoint = section.settings.api_endpoint | strip
  if tw_endpoint == blank
    assign tw_endpoint = '/api/chat'
  endif
  assign tw_store_domain = section.settings.store_domain | strip
  if tw_store_domain == blank
    assign tw_store_domain = 'testallwater.co.uk'
  endif
  assign tw_floating = false
  if section.settings.display_mode == 'floating'
    assign tw_floating = true
  endif
-%}
<div
  class="tw-assistant-root{% if tw_floating %} tw-mode-floating{% else %} tw-mode-inline{% endif %}"
  id="tw-assistant-{{ tw_id }}"
  data-tw-endpoint="{{ tw_endpoint | escape }}"
  data-tw-store-domain="{{ tw_store_domain | escape }}"
  data-tw-floating="{{ tw_floating }}"
  style="--tw-brand: {{ section.settings.accent_color | default: '#0a5f9f' }};"
>
  <style>
    .tw-assistant-root, .tw-assistant-root *{box-sizing:border-box}
    #tw-assistant-{{ tw_id }}{
      --tw-brand-dark:#084d80;--tw-brand-soft:#eaf4fb;
      --tw-ink:#17242d;--tw-muted:#687780;--tw-line:#e4eaed;--tw-surface:#fff;--tw-bg:#f7f9fa;
      font-family:"DM Sans",-apple-system,BlinkMacSystemFont,Arial,sans-serif;color:var(--tw-ink);
      -webkit-font-smoothing:antialiased;
    }
    #tw-assistant-{{ tw_id }} .tw-assistant-wrap{max-width:780px;margin:0 auto}
    #tw-assistant-{{ tw_id }}.tw-mode-inline .tw-assistant-wrap{padding:16px 0}
    #tw-assistant-{{ tw_id }} .tw-card{
      background:var(--tw-surface);border:1px solid var(--tw-line);border-radius:16px;
      box-shadow:0 1px 2px rgba(23,36,45,.05),0 10px 28px rgba(23,36,45,.05);overflow:hidden;
    }

    #tw-assistant-{{ tw_id }} .tw-head{padding:14px 20px;border-bottom:1px solid var(--tw-line);display:flex;align-items:center;justify-content:space-between;background:var(--tw-surface);gap:12px}
    #tw-assistant-{{ tw_id }} .tw-brand{display:flex;align-items:center;gap:12px;min-width:0}
    #tw-assistant-{{ tw_id }} .tw-ai-icon{width:40px;height:40px;flex:0 0 40px;border-radius:50%;background:var(--tw-brand);position:relative}
    #tw-assistant-{{ tw_id }} .tw-ai-icon:before{content:"";position:absolute;top:50%;left:50%;width:13px;height:13px;background:#fff;border-radius:50% 50% 50% 0;transform:translate(-65%,-58%) rotate(-45deg);opacity:.95}
    #tw-assistant-{{ tw_id }} .tw-ai-icon:after{content:"";position:absolute;right:-1px;bottom:-1px;width:10px;height:10px;background:#28a966;border:2px solid #fff;border-radius:50%}
    #tw-assistant-{{ tw_id }} .tw-brand-copy{min-width:0}
    #tw-assistant-{{ tw_id }} .tw-brand-copy strong{font-size:15px;font-weight:700;color:var(--tw-ink);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    #tw-assistant-{{ tw_id }} .tw-head-meta{display:flex;align-items:center;gap:6px;margin-top:3px;font-size:12px;color:var(--tw-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    #tw-assistant-{{ tw_id }} .tw-online{display:flex;align-items:center;gap:5px;flex:0 0 auto}
    #tw-assistant-{{ tw_id }} .tw-online i{width:6px;height:6px;border-radius:50%;background:#28a966;display:inline-block}
    #tw-assistant-{{ tw_id }} .tw-head-dot{opacity:.5;flex:0 0 auto}
    #tw-assistant-{{ tw_id }} .tw-head-tag{color:var(--tw-muted);overflow:hidden;text-overflow:ellipsis}
    #tw-assistant-{{ tw_id }} .tw-headbtns{display:flex;gap:4px;flex:0 0 auto}
    #tw-assistant-{{ tw_id }} .tw-iconbtn{border:0;background:transparent;color:var(--tw-muted);width:32px;height:32px;border-radius:8px;font-size:15px;cursor:pointer;transition:background .15s ease,color .15s ease;display:grid;place-items:center;line-height:1}
    #tw-assistant-{{ tw_id }} .tw-iconbtn:hover{background:#f1f4f5;color:var(--tw-ink)}
    #tw-assistant-{{ tw_id }} .tw-iconbtn:focus-visible{outline:2px solid var(--tw-brand);outline-offset:2px}

    #tw-assistant-{{ tw_id }} .tw-body{height:min(72vh,580px);display:flex;flex-direction:column;background:var(--tw-bg)}
    #tw-assistant-{{ tw_id }} .tw-messages{flex:1;overflow-y:auto;overflow-x:hidden;padding:22px 20px 8px;scroll-behavior:smooth;min-height:0}
    #tw-assistant-{{ tw_id }} .tw-messages::-webkit-scrollbar{width:7px}
    #tw-assistant-{{ tw_id }} .tw-messages::-webkit-scrollbar-thumb{background:#dce3e8;border-radius:20px}

    #tw-assistant-{{ tw_id }} .tw-hero{padding:4px 2px 22px;margin-bottom:4px}
    #tw-assistant-{{ tw_id }} .tw-hero-eyebrow{margin:0 0 8px;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--tw-brand)}
    #tw-assistant-{{ tw_id }} .tw-hero-title{margin:0 0 8px;font-size:22px;line-height:1.28;font-weight:700;color:var(--tw-ink);letter-spacing:-.01em}
    #tw-assistant-{{ tw_id }} .tw-hero-text{margin:0;font-size:14px;line-height:1.6;color:var(--tw-muted);max-width:48ch}

    #tw-assistant-{{ tw_id }} .tw-quick{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;padding:14px 20px 18px;background:var(--tw-surface);border-top:1px solid var(--tw-line)}
    #tw-assistant-{{ tw_id }} .tw-start-card{display:flex;align-items:center;gap:10px;text-align:left;padding:11px 12px;border:1px solid var(--tw-line);border-radius:10px;background:var(--tw-surface);color:var(--tw-ink);font-size:13px;font-weight:600;cursor:pointer;transition:border-color .15s ease,background .15s ease}
    #tw-assistant-{{ tw_id }} .tw-start-card:hover{border-color:var(--tw-brand);background:var(--tw-brand-soft)}
    #tw-assistant-{{ tw_id }} .tw-start-card:focus-visible{outline:2px solid var(--tw-brand);outline-offset:1px}
    #tw-assistant-{{ tw_id }} .tw-start-icon{width:26px;height:26px;flex:0 0 26px;border-radius:50%;background:var(--tw-brand-soft);position:relative}
    #tw-assistant-{{ tw_id }} .tw-start-icon:before{content:"";position:absolute;top:50%;left:50%;width:8px;height:8px;background:var(--tw-brand);border-radius:50% 50% 50% 0;transform:translate(-65%,-58%) rotate(-45deg)}
    #tw-assistant-{{ tw_id }} .tw-start-label{flex:1;min-width:0;line-height:1.35}
    @media (max-width:420px){
      #tw-assistant-{{ tw_id }} .tw-quick{grid-template-columns:1fr}
    }

    #tw-assistant-{{ tw_id }} .tw-row{display:grid;grid-template-columns:26px 1fr;column-gap:10px;row-gap:8px;margin-bottom:18px;align-items:start}
    #tw-assistant-{{ tw_id }} .tw-row.user{display:flex;gap:10px;justify-content:flex-end}
    #tw-assistant-{{ tw_id }} .tw-avatar{grid-column:1;grid-row:1;width:26px;height:26px;flex:0 0 26px;border-radius:50%;background:var(--tw-brand-soft);position:relative;margin-top:3px}
    #tw-assistant-{{ tw_id }} .tw-avatar:before{content:"";position:absolute;top:50%;left:50%;width:8px;height:8px;background:var(--tw-brand);border-radius:50% 50% 50% 0;transform:translate(-65%,-58%) rotate(-45deg)}
    #tw-assistant-{{ tw_id }} .tw-bubble{grid-column:2;grid-row:1;min-width:0;max-width:min(560px,86%);font-size:14.5px;line-height:1.65;color:var(--tw-ink);white-space:pre-wrap;word-break:break-word;overflow-wrap:anywhere}
    #tw-assistant-{{ tw_id }} .tw-row.user .tw-bubble{max-width:86%;background:var(--tw-brand);color:#fff;border-radius:12px;border-bottom-right-radius:4px;padding:11px 14px}
    #tw-assistant-{{ tw_id }} .tw-row.assistant .tw-bubble{padding-top:2px}
    #tw-assistant-{{ tw_id }} .tw-bubble.md{white-space:normal}
    #tw-assistant-{{ tw_id }} .tw-bubble.md>:first-child{margin-top:0}
    #tw-assistant-{{ tw_id }} .tw-bubble.md>:last-child{margin-bottom:0}
    #tw-assistant-{{ tw_id }} .tw-bubble.md p{margin:0 0 .65em}
    #tw-assistant-{{ tw_id }} .tw-bubble.md ul,#tw-assistant-{{ tw_id }} .tw-bubble.md ol{margin:.2em 0 .65em;padding-left:1.3em}
    #tw-assistant-{{ tw_id }} .tw-bubble.md li{margin:.25em 0}
    #tw-assistant-{{ tw_id }} .tw-bubble.md code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.9em;background:var(--tw-bg);border-radius:6px;padding:.1em .38em}
    #tw-assistant-{{ tw_id }} .tw-bubble.md pre{margin:.3em 0 .65em;padding:10px 12px;background:var(--tw-bg);border:1px solid var(--tw-line);border-radius:10px;overflow:auto;white-space:pre}
    #tw-assistant-{{ tw_id }} .tw-bubble.md pre code{background:none;padding:0;font-size:.88em}
    #tw-assistant-{{ tw_id }} .tw-bubble.md a{color:var(--tw-brand);text-decoration:underline;text-underline-offset:2px}
    #tw-assistant-{{ tw_id }} .tw-bubble.md hr{border:0;border-top:1px solid var(--tw-line);margin:.8em 0}

    #tw-assistant-{{ tw_id }} .tw-row.tw-products{display:block;margin-top:-6px;padding-left:36px}
    #tw-assistant-{{ tw_id }} .tw-pcards{display:flex;flex-direction:column;gap:10px;width:100%}
    #tw-assistant-{{ tw_id }} .tw-pcard{display:flex;gap:14px;padding:14px;background:var(--tw-surface);border:1px solid var(--tw-line);border-radius:12px}
    #tw-assistant-{{ tw_id }} .tw-pimg{flex:0 0 92px;width:92px;height:92px;border-radius:10px;background:var(--tw-bg);border:1px solid var(--tw-line);display:grid;place-items:center;overflow:hidden;text-decoration:none}
    #tw-assistant-{{ tw_id }} .tw-pimg img{width:100%;height:100%;object-fit:contain;padding:8px;box-sizing:border-box}
    #tw-assistant-{{ tw_id }} .tw-pimg.tw-noimg{color:var(--tw-muted);font-size:10px;text-align:center;padding:6px}
    #tw-assistant-{{ tw_id }} .tw-pbody{flex:1;min-width:0;display:flex;flex-direction:column;gap:5px}
    #tw-assistant-{{ tw_id }} .tw-pvendor{font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;font-weight:700;color:var(--tw-muted)}
    #tw-assistant-{{ tw_id }} .tw-ptitle{font-size:14.5px;font-weight:700;line-height:1.35;color:var(--tw-ink);text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    #tw-assistant-{{ tw_id }} .tw-ptitle:hover{color:var(--tw-brand)}
    #tw-assistant-{{ tw_id }} .tw-pmeta{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    #tw-assistant-{{ tw_id }} .tw-pprice{font-size:17px;font-weight:800;color:var(--tw-ink);letter-spacing:-.01em}
    #tw-assistant-{{ tw_id }} .tw-pstock{font-size:11px;font-weight:600;color:#1f8a57;display:flex;align-items:center;gap:5px}
    #tw-assistant-{{ tw_id }} .tw-pstock:before{content:"";width:6px;height:6px;border-radius:50%;background:#1f8a57;display:inline-block}
    #tw-assistant-{{ tw_id }} .tw-preason{margin:0;font-size:12.5px;line-height:1.5;color:var(--tw-muted)}
    #tw-assistant-{{ tw_id }} .tw-pactions{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px}
    #tw-assistant-{{ tw_id }} .tw-pbtn{display:inline-flex;align-items:center;justify-content:center;height:34px;padding:0 14px;border-radius:9px;font-size:13px;font-weight:600;text-decoration:none;cursor:pointer;white-space:nowrap;transition:background .15s ease,border-color .15s ease,color .15s ease}
    #tw-assistant-{{ tw_id }} .tw-pbtn-primary{background:var(--tw-brand);color:#fff}
    #tw-assistant-{{ tw_id }} .tw-pbtn-primary:hover{background:var(--tw-brand-dark)}
    #tw-assistant-{{ tw_id }} .tw-pbtn-ghost{background:var(--tw-surface);color:var(--tw-ink);border:1px solid var(--tw-line)}
    #tw-assistant-{{ tw_id }} .tw-pbtn-ghost:hover{border-color:var(--tw-brand);color:var(--tw-brand)}

    #tw-assistant-{{ tw_id }} .tw-replies{grid-column:2;grid-row:2;display:flex;flex-direction:column;gap:7px;max-width:420px}
    #tw-assistant-{{ tw_id }} .tw-reply{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;text-align:left;border:1px solid var(--tw-line);background:var(--tw-surface);color:var(--tw-ink);border-radius:10px;padding:10px 13px;font-size:13.5px;font-weight:600;cursor:pointer;transition:border-color .15s ease,background .15s ease}
    #tw-assistant-{{ tw_id }} .tw-reply:after{content:"\2192";opacity:0;transform:translateX(-3px);transition:opacity .15s ease,transform .15s ease;color:var(--tw-brand);font-size:13px}
    #tw-assistant-{{ tw_id }} .tw-reply:hover{border-color:var(--tw-brand);background:var(--tw-brand-soft)}
    #tw-assistant-{{ tw_id }} .tw-reply:hover:after{opacity:1;transform:translateX(0)}
    #tw-assistant-{{ tw_id }} .tw-reply:focus-visible{outline:2px solid var(--tw-brand);outline-offset:1px}
    #tw-assistant-{{ tw_id }} .tw-reply.other{color:var(--tw-muted);border-style:dashed;background:transparent;font-weight:600}
    #tw-assistant-{{ tw_id }} .tw-reply.other:after{content:""}

    #tw-assistant-{{ tw_id }} .tw-typing{display:none;align-items:center;gap:8px;padding:0 20px 10px;color:var(--tw-muted);font-size:12.5px}
    #tw-assistant-{{ tw_id }} .tw-typing.show{display:flex}
    #tw-assistant-{{ tw_id }} .tw-dots{display:inline-flex;gap:3px}
    #tw-assistant-{{ tw_id }} .tw-dots i{width:4px;height:4px;background:#9aa7ae;border-radius:50%;animation:tw-dot-{{ tw_id }} 1s infinite}
    #tw-assistant-{{ tw_id }} .tw-dots i:nth-child(2){animation-delay:.15s}
    #tw-assistant-{{ tw_id }} .tw-dots i:nth-child(3){animation-delay:.3s}
    @keyframes tw-dot-{{ tw_id }}{0%,70%,100%{opacity:.25}35%{opacity:1}}

    #tw-assistant-{{ tw_id }} .tw-inputbar{display:flex;gap:10px;padding:14px 20px;background:var(--tw-surface);border-top:1px solid var(--tw-line)}
    #tw-assistant-{{ tw_id }} .tw-inputwrap{flex:1;min-width:0;display:flex;align-items:center;border:1px solid var(--tw-line);border-radius:10px;background:var(--tw-surface);padding:0 14px;transition:border-color .15s ease,box-shadow .15s ease}
    #tw-assistant-{{ tw_id }} .tw-inputwrap:focus-within{border-color:var(--tw-brand);box-shadow:0 0 0 3px rgba(10,95,159,.08)}
    #tw-assistant-{{ tw_id }} .tw-input{width:100%;border:0;outline:0;padding:13px 0;font-size:14.5px;background:transparent;color:var(--tw-ink);font-family:inherit}
    #tw-assistant-{{ tw_id }} .tw-input::placeholder{color:#9aa7ae}
    #tw-assistant-{{ tw_id }} .tw-send{border:0;background:var(--tw-brand);color:#fff;border-radius:10px;width:46px;flex:0 0 46px;font-size:16px;font-weight:700;cursor:pointer;display:grid;place-items:center;transition:background .15s ease}
    #tw-assistant-{{ tw_id }} .tw-send:hover:not(:disabled){background:var(--tw-brand-dark)}
    #tw-assistant-{{ tw_id }} .tw-send:disabled{opacity:.45;cursor:not-allowed}
    #tw-assistant-{{ tw_id }} .tw-foot{text-align:center;background:var(--tw-surface);color:#9aa7ae;font-size:11px;padding:0 16px 14px}

    #tw-assistant-{{ tw_id }}.tw-mode-floating{position:fixed;right:18px;bottom:18px;z-index:999999;width:min(380px,calc(100vw - 36px))}
    #tw-assistant-{{ tw_id }}.tw-mode-floating .tw-panel{display:none}
    #tw-assistant-{{ tw_id }}.tw-mode-floating.tw-open .tw-panel{display:block}
    #tw-assistant-{{ tw_id }}.tw-mode-floating .tw-launcher{display:flex}
    #tw-assistant-{{ tw_id }}.tw-mode-floating.tw-open .tw-launcher{display:none}
    #tw-assistant-{{ tw_id }} .tw-launcher{display:none;align-items:center;justify-content:center;width:56px;height:56px;border-radius:50%;border:0;background:var(--tw-brand);color:#fff;cursor:pointer;box-shadow:0 10px 25px rgba(10,95,159,.28);margin-left:auto;position:relative}
    #tw-assistant-{{ tw_id }} .tw-launcher:before{content:"";position:absolute;top:50%;left:50%;width:16px;height:16px;background:#fff;border-radius:50% 50% 50% 0;transform:translate(-65%,-58%) rotate(-45deg);opacity:.95}
    #tw-assistant-{{ tw_id }}.tw-mode-inline .tw-close-btn{display:none}

    @media (max-width:520px){
      #tw-assistant-{{ tw_id }}.tw-mode-floating{right:10px;bottom:10px;left:10px;width:auto}
      #tw-assistant-{{ tw_id }} .tw-body{height:min(78vh,540px)}
      #tw-assistant-{{ tw_id }} .tw-messages{padding:18px 16px 8px}
      #tw-assistant-{{ tw_id }} .tw-quick{padding:12px 16px 16px}
      #tw-assistant-{{ tw_id }} .tw-inputbar{padding:12px 16px}
      #tw-assistant-{{ tw_id }} .tw-head{padding:12px 16px}
      #tw-assistant-{{ tw_id }} .tw-row.user .tw-bubble{max-width:90%}
      #tw-assistant-{{ tw_id }} .tw-replies{max-width:100%}
      #tw-assistant-{{ tw_id }} .tw-row.tw-products{padding-left:0}
      #tw-assistant-{{ tw_id }} .tw-pcard{flex-direction:column}
      #tw-assistant-{{ tw_id }} .tw-pimg{width:100%;height:170px;flex:none}
      #tw-assistant-{{ tw_id }} .tw-pactions{flex-direction:column}
      #tw-assistant-{{ tw_id }} .tw-pbtn{width:100%;height:42px}
      #tw-assistant-{{ tw_id }} .tw-launcher{margin-left:0;align-self:flex-end}
    }
  </style>

  <div class="tw-assistant-wrap">
    <div class="tw-panel">
      <div class="tw-card">
        <div class="tw-head">
          <div class="tw-brand">
            <div class="tw-ai-icon" aria-hidden="true"></div>
            <div class="tw-brand-copy">
              <strong>{{ section.settings.heading | default: 'TestAllWater AI Assistant' | escape }}</strong>
              <div class="tw-head-meta">
                <span class="tw-online"><i></i><span id="tw-status-{{ tw_id }}">AI ready</span></span>
                <span class="tw-head-dot" aria-hidden="true">·</span>
                <span class="tw-head-tag">Here to help</span>
              </div>
            </div>
          </div>
          <div class="tw-headbtns">
            <button type="button" class="tw-iconbtn" id="tw-restart-{{ tw_id }}" aria-label="Start a new conversation" title="Start a new conversation">↺</button>
            <button type="button" class="tw-iconbtn tw-close-btn" id="tw-close-{{ tw_id }}" aria-label="Close">×</button>
          </div>
        </div>
        <div class="tw-body">
          <div class="tw-messages" id="tw-messages-{{ tw_id }}" role="log" aria-live="polite">
            <div class="tw-hero">
              <p class="tw-hero-eyebrow">Water testing assistant</p>
              <h2 class="tw-hero-title">{{ section.settings.welcome_title | default: "Hi! Let's find the right test." | escape }}</h2>
              <p class="tw-hero-text">{{ section.settings.welcome_text | default: "Describe your water issue in your own words. No technical terms needed — I'll ask the important questions as we go." | escape }}</p>
            </div>
          </div>
          <div class="tw-quick" id="tw-quick-{{ tw_id }}">
            {%- for block in section.blocks -%}
              {%- if block.type == 'quick_prompt' and block.settings.text != blank -%}
                <button type="button" class="tw-start-card">
                  <span class="tw-start-icon" aria-hidden="true"></span>
                  <span class="tw-start-label">{{ block.settings.text | escape }}</span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="tw-typing" id="tw-typing-{{ tw_id }}"><span class="tw-typing-text">Finding the right test…</span><span class="tw-dots"><i></i><i></i><i></i></span></div>
          <form class="tw-inputbar" id="tw-form-{{ tw_id }}">
            <div class="tw-inputwrap">
              <input class="tw-input" id="tw-input-{{ tw_id }}" placeholder="Tell us about your water…" autocomplete="off" aria-label="Your message">
            </div>
            <button type="submit" class="tw-send" id="tw-send-{{ tw_id }}" aria-label="Send">↑</button>
          </form>
          <div class="tw-foot">AI assistant · Products from the live TestAllWater catalog</div>
        </div>
      </div>
    </div>
    <button type="button" class="tw-launcher" id="tw-launcher-{{ tw_id }}" aria-label="Open water-testing assistant"></button>
  </div>
</div>

<script>
(function () {
  "use strict";
  var root = document.getElementById("tw-assistant-{{ tw_id }}");
  // Every element this script needs is looked up by its own unique, section-id-suffixed id
  // (not via root.querySelector), so this works in a plain DOM where elements are addressed
  // by id, matching how the rest of this project's front-end code is already structured and
  // tested (test/ui.test.js's fake DOM supports getElementById, not full CSS querying).
  if (!root || root.getAttribute("data-tw-booted") === "1") return; // never double-initialize
  root.setAttribute("data-tw-booted", "1");

  var ENDPOINT = root.getAttribute("data-tw-endpoint") || "/api/chat";
  var FLOATING = root.getAttribute("data-tw-floating") === "true";

