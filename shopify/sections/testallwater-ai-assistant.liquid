})();
</script>

{% schema %}
{
  "name": "TestAllWater AI Assistant",
  "settings": [
    {
      "type": "header",
      "content": "API connection"
    },
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "API endpoint URL",
      "info": "Full URL of the deployed Vercel /api/chat endpoint, e.g. https://your-app.vercel.app/api/chat. Leave blank only for local testing where the storefront and the API share an origin — in production this must be the absolute URL, and the Vercel deployment's CORS_ALLOWED_ORIGINS should be set to this store's domain."
    },
    {
      "type": "text",
      "id": "store_domain",
      "label": "Storefront domain (for product card validation)",
      "default": "testallwater.co.uk",
      "info": "Must match the Shopify store domain the API's product links point to. Product cards whose link isn't on this domain, or whose image isn't from this domain or cdn.shopify.com, are never rendered."
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        { "value": "inline", "label": "Inline (embedded in the page)" },
        { "value": "floating", "label": "Floating launcher (bottom-right bubble)" }
      ],
      "default": "inline"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0a5f9f"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TestAllWater AI Assistant"
    },
    {
      "type": "text",
      "id": "welcome_title",
      "label": "Welcome message title",
      "default": "Hi! Let's find the right test."
    },
    {
      "type": "textarea",
      "id": "welcome_text",
      "label": "Welcome message text",
      "default": "Describe your water issue in your own words. No technical terms needed — I'll ask the important questions as we go."
    }
  ],
  "blocks": [
    {
      "type": "quick_prompt",
      "name": "Quick reply suggestion",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Suggested message",
          "default": "My pool water is cloudy"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "TestAllWater AI Assistant",
      "blocks": [
        { "type": "quick_prompt", "settings": { "text": "My pool water is cloudy" } },
        { "type": "quick_prompt", "settings": { "text": "I need to test drinking water" } },
        { "type": "quick_prompt", "settings": { "text": "My chlorine seems too high" } },
        { "type": "quick_prompt", "settings": { "text": "I need a general water test" } }
      ]
    }
  ]
}
{% endschema %}
