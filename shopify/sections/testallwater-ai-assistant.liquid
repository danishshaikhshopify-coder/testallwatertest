  function friendlyError(e) {
    if ((e && e.name === "AbortError") || (e && e.code === "timeout") || (e && e.status === 504))
      return "Sorry, that took longer than expected and I couldn't get an answer in time. Please send your message again — our conversation is still here, so you won't need to start over.";
    if ((e && e.code === "rate_limited") || (e && e.status === 429))
      return "I'm getting a lot of questions right now. Please try again in a moment.";
    return "Sorry, something went wrong on my side and I couldn't answer that. Please try again.";
  }
  // STORE_HOST/IMG_HOSTS default here (self-contained, so this block can be extracted and
  // tested on its own, same as the rest of /*<render>*/); the real section setting value is
  // applied right after this block closes, reassigning the same variables.
  var STORE_HOST = "testallwater.co.uk";
  var IMG_HOSTS = ["cdn.shopify.com", STORE_HOST];
  var PRICE_OK = /^(?:From )?£\d{1,3}(?:,\d{3})*\.\d{2}$/;
  function shopUrl(u, exactPath, prefix) {
    try {
      var x = new URL(u);
      if (x.protocol !== "https:" || x.host !== STORE_HOST) return null;
      if (exactPath && x.pathname !== exactPath) return null;
      if (prefix && x.pathname.indexOf(prefix) !== 0) return null;
      return x.href;
    } catch (e) { return null; }
  }
  function imgUrl(u) {
    try { var x = new URL(u); return x.protocol === "https:" && IMG_HOSTS.indexOf(x.host) !== -1 ? x.href : null; } catch (e) { return null; }
  }
  function cardLink(doc, cls, href, text) {
    var a = doc.createElement("a"); a.className = cls;
    a.setAttribute("href", href); a.setAttribute("target", "_blank"); a.setAttribute("rel", "noopener noreferrer");
    if (text) a.textContent = text;
    return a;
  }
  function productCard(p, doc) {
    if (!p || typeof p !== "object" || p.available === false) return null;
    var url = shopUrl(p.url, null, "/products/");
    var title = typeof p.title === "string" ? p.title.trim().slice(0, 200) : "";
    var price = p.price && typeof p.price.display === "string" ? (p.price.from ? "From " : "") + p.price.display : "";
    if (!url || !title || !PRICE_OK.test(price)) return null;

    var card = doc.createElement("article"); card.className = "tw-pcard";
    card.setAttribute("role", "listitem"); card.setAttribute("aria-label", title);

    var src = imgUrl(p.image);
    var imgBox;
    if (src) {
      imgBox = cardLink(doc, "tw-pimg", url); imgBox.setAttribute("aria-label", "View " + title);
      var img = doc.createElement("img");
      img.setAttribute("src", src); img.setAttribute("alt", title); img.setAttribute("loading", "lazy");
      img.setAttribute("width", "92"); img.setAttribute("height", "92");
      if (img.addEventListener) img.addEventListener("error", function () { imgBox.className = "tw-pimg tw-noimg"; imgBox.textContent = "No image"; });
      imgBox.appendChild(img);
    } else {
      imgBox = doc.createElement("div"); imgBox.className = "tw-pimg tw-noimg"; imgBox.textContent = "No image";
    }
    card.appendChild(imgBox);

    var body = doc.createElement("div"); body.className = "tw-pbody";
    if (typeof p.vendor === "string" && p.vendor.trim()) {
      var v = doc.createElement("div"); v.className = "tw-pvendor"; v.textContent = p.vendor.trim().slice(0, 60); body.appendChild(v);
    }
    body.appendChild(cardLink(doc, "tw-ptitle", url, title));

    var meta = doc.createElement("div"); meta.className = "tw-pmeta";
    var pr = doc.createElement("span"); pr.className = "tw-pprice"; pr.textContent = price; meta.appendChild(pr);
    var st = doc.createElement("span"); st.className = "tw-pstock"; st.textContent = "In stock"; meta.appendChild(st);
    body.appendChild(meta);

    if (typeof p.reason === "string" && p.reason.trim()) {
      var r = doc.createElement("p"); r.className = "tw-preason"; r.textContent = p.reason.trim().slice(0, 240); body.appendChild(r);
    }

    var actions = doc.createElement("div"); actions.className = "tw-pactions";
    actions.appendChild(cardLink(doc, "tw-pbtn tw-pbtn-primary", url, "View product"));
    var cart = shopUrl(p.addToCartUrl, "/cart/add");
    if (cart) {
      var cartId = new URL(cart).searchParams.get("id") || "";
      if (/^\d+$/.test(cartId)) actions.appendChild(cardLink(doc, "tw-pbtn tw-pbtn-ghost", cart, "Add to cart"));
    }
    body.appendChild(actions);

    card.appendChild(body);
    return card;
  }
  function renderProductCards(list, doc, parent) {
    var shown = [];
    var arr = Array.isArray(list) ? list.slice(0, 3) : [];
    for (var i = 0; i < arr.length; i++) {
      var card = productCard(arr[i], doc);
      if (card) { parent.appendChild(card); shown.push(arr[i]); }
    }
    return shown;
  }
  /*</render>*/

  // Apply the real "Storefront domain" section setting now that the render block above (kept
  // self-contained, with its own default, for testability) has finished declaring STORE_HOST.
  STORE_HOST = (root.getAttribute("data-tw-store-domain") || STORE_HOST).toLowerCase();
  IMG_HOSTS = ["cdn.shopify.com", STORE_HOST];

  var shownProducts = {};
  function addProducts(list, readiness) {
    if (!readiness || readiness.ready !== true) return;
    var fresh = (Array.isArray(list) ? list : []).filter(function (p) {
      return p && typeof p.url === "string" && !shownProducts[p.url];
    });
    if (!fresh.length) return;
    var wrap = document.createElement("div"); wrap.className = "tw-pcards"; wrap.setAttribute("role", "list"); wrap.setAttribute("aria-label", "Matching products");
    var rendered = renderProductCards(fresh, document, wrap);
    if (!rendered.length) return;
    rendered.forEach(function (p) { shownProducts[p.url] = true; });
    var row = document.createElement("div"); row.className = "tw-row assistant tw-products";
    row.appendChild(wrap); messages.appendChild(row);
    requestAnimationFrame(function () { messages.scrollTop = messages.scrollHeight; });
  }
  function addMessage(role, text, options) {
    options = options || [];
    var row = document.createElement("div"); row.className = "tw-row " + role;
    if (role === "assistant" && options.length) row.classList.add("has-options");
    if (role === "assistant") { var av = document.createElement("div"); av.className = "tw-avatar"; av.setAttribute("aria-hidden", "true"); row.appendChild(av); }
    var bubble = document.createElement("div"); bubble.className = "tw-bubble";
    if (role === "assistant") { bubble.classList.add("md"); renderMarkdown(text, document, bubble); } else bubble.textContent = text;
    row.appendChild(bubble);
    if (role === "assistant" && options.length) {
      var replies = document.createElement("div"); replies.className = "tw-replies"; replies.setAttribute("role", "group"); replies.setAttribute("aria-label", "Suggested answers");
      options.slice(0, 6).forEach(function (option) {
        if (!option || typeof option.label !== "string" || typeof option.value !== "string") return;
        var button = document.createElement("button"); button.type = "button";
        button.className = "tw-reply" + (option.value === "__other__" ? " other" : "");
        button.textContent = option.label;
        button.onclick = function () {
          if (busy) return;
          if (option.value === "__other__") { input.focus(); return; }
          ask(option.value);
        };
        replies.appendChild(button);
